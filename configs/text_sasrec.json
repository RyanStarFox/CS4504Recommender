{
  "seed": 42,
  "threads": 4,
  "sequences": "data/sequences.json",
  "movies": "ml-1m/movies.dat",
  "features": {
    "gpt2": "data/gpt2_movie_features.pt",
    "qwen": "data/qwen_movie_features.pt"
  },
  "model": {
    "rec_hidden_size": 64,
    "max_seq_len": 50,
    "num_blocks": 2,
    "num_heads": 2,
    "dropout": 0.2
  },
  "training": {
    "epochs": 50,
    "batch_size": 128,
    "eval_batch_size": 256,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "patience": 5
  },
  "checkpoint_dir": "checkpoints",
  "report_dir": "data/text_sasrec",
  "results": "data/results.csv"
}
